# Repo-root ignores. Each engine also has its own .gitignore
# (dast-engine/.gitignore, sast-engine/.gitignore) for engine-specific paths.

# Python bytecode / caches — never commit (covers common/, scripts, anything new at the root)
__pycache__/
*.py[cod]
.pytest_cache/

# Virtual environments
.venv/
venv/

# Correlator output (python -m correlator.cli --out out/issues.json)
out/

# Local vulnerability benchmark checkouts
benchmarks/dvwa/
benchmarks/juice-shop/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
