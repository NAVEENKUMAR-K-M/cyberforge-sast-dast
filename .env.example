# Copy this file to .env. .env is ignored by git; never commit it.
#
# Optional AI-assisted follow-up for findings the first re-test can't settle. Leave the keys empty to skip it: the scan still
# runs in full and nothing leaves this machine. More than one key spreads the calls and rides out rate limits:
# add GROQ_API_KEY_2, GROQ_API_KEY_3, ...
GROQ_API_KEY=
GROQ_API_KEY_2=

# Docker only. Docker Compose reads this file, so you can set these here instead of on the command line.
# The folder holding the source code of the application you scan, mounted read-only at /workspace (default: ./workspace):
# TARGET_SOURCE=/path/to/the/application/source
# The port the workspace is published on, on 127.0.0.1 (default: 8000):
# CYBERFORGE_PORT=8000
