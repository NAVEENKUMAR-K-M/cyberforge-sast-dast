{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DAST/SAST shared finding schema",
  "type": "object",
  "required": ["finding_id", "source", "cwe", "title", "severity", "confidence", "method", "url", "route_template", "scope"],
  "properties": {
    "finding_id": {"type": "string", "description": "sha1(cwe|method|route_template|param|location); stable across re-runs"},
    "source": {"type": "string", "enum": ["dast", "sast"]},
    "tool": {"type": "string"},
    "cwe": {"type": "string", "pattern": "^CWE-\\d+$"},
    "title": {"type": "string"},
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "confidence": {"type": "string", "enum": ["confirmed", "firm", "tentative"]},
    "method": {"type": "string"},
    "url": {"type": "string"},
    "route_template": {"type": "string"},
    "selector": {"type": ["string", "null"], "description": "query value that picks this page on a shared path, e.g. action=view"},
    "param": {"type": ["string", "null"]},
    "param_location": {"type": ["string", "null"], "enum": ["query", "body", "json", "path", "header", "cookie", null]},
    "payload": {"type": "string"},
    "technique": {"type": "string"},
    "evidence": {
      "type": "object",
      "properties": {
        "request": {"type": "string"},
        "response_excerpt": {"type": "string"},
        "matched": {"type": "string"},
        "baseline_status": {"type": ["integer", "null"]},
        "probe_status": {"type": ["integer", "null"]}
      }
    },
    "scope": {"type": "string", "enum": ["endpoint", "app"]},
    "timestamp": {"type": "number"}
  }
}
