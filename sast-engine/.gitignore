# Scope: this file covers sast-engine/ only. dast-engine/ has its own rules.

# --- Secrets and credentials: never commit ---
# The benchmark shop plants fake secrets in its source on purpose. Those are source files, not matched here.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
id_rsa*
id_ed25519*
id_ecdsa*
*.secret
*.secrets
secrets/
credentials.json
*credentials*.json
service-account*.json
.aws/
.ssh/
.npmrc
.pypirc
.netrc
.git-credentials

# --- Python environments and build output ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Generated by the engine ---
# Scan output. Anyone can regenerate it with `python -m sast.cli scan`.
out/
findings.json
routes.json
findings.sarif

# --- Downloaded vulnerable apps ---
# Fetched by benchmarks/fetch.sh at pinned commits. Third-party code, large, deliberately insecure.
benchmarks/external/

# --- Local databases and logs ---
*.sqlite
*.sqlite3
*.db
*.log
tmp/
.tmp/

# --- Local overrides ---
docker-compose.override.yml

# --- OS and editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
